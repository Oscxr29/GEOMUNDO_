{
  "name": "geomundo",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace ./backend",
    "build:backend": "npm run build --workspace ./backend",
    "start:backend": "npm run start --workspace ./backend",
    "test:backend": "npm run test --workspace ./backend",
    "test:backend:watch": "npm run test:watch --workspace ./backend",
    "dev:frontend": "npm run dev --workspace ./frontend",
    "build:frontend": "npm run build --workspace ./frontend",
    "preview:frontend": "npm run preview --workspace ./frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "test:integration": "node scripts/send_test_sessions.mjs",
    "test:content": "node scripts/provision_and_verify_content.mjs"
  },
  "dependencies": {
    "mysql2": "^3.22.4"
  }
}
